@using NguyenTatKhoa_2380601071.Toeic.Dto
@model QuestionManagementDto
<article class="question-preview" id="question-@Model.OriginalNumber"><h4><span class="question-number">@Model.OriginalNumber</span>@Model.Prompt</h4><div class="option-list">@foreach (var option in Model.Options.OrderBy(option => option.DisplayOrder)) { <div class="option-item @(option.Id == Model.CorrectOptionId ? "correct" : "")"><span class="option-letter">@option.Key</span><span>@option.Text</span>@if (option.Id == Model.CorrectOptionId) { <span class="muted" aria-label="Đáp án đúng" style="margin-left:auto">✓</span> }</div> }</div>@if (!string.IsNullOrWhiteSpace(Model.Hint)) { <div class="hint"><strong>Gợi ý:</strong> @Model.Hint</div> }<div class="shuffle-meta">Hoán vị câu: @(Model.AllowQuestionShuffle ? "Cho phép" : "Giữ thứ tự") · Lựa chọn: @(Model.AllowOptionShuffle ? "Cho phép" : "Giữ thứ tự")</div></article>
