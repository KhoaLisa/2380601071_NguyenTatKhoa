@using NguyenTatKhoa_2380601071.Toeic.Dto
@using System.Globalization
@model ExamStatisticsDto
@{
    Layout = "~/Views/Shared/_ToeicLayout.cshtml";
    ViewBag.Title = "Thống kê kết quả";
    ViewBag.Section = "Statistics";
    var maximum = Model.TopIncorrectQuestions.Count > 0 ? Math.Max(1, Model.TopIncorrectQuestions.Max(question => question.IncorrectCount)) : 1;
}
<div class="page-heading"><div><span class="eyebrow">KẾT QUẢ HỌC TẬP</span><h1>Hiểu kết quả. Mở hướng tiến bộ.</h1><p>@Model.ExamTitle · Dữ liệu từ lượt làm bài đã lưu trong hệ thống.</p></div><a asp-action="Details" asp-route-id="@Model.ExamId" class="button">← Quay lại đề thi</a></div>
<section class="metrics"><article class="metric"><div class="metric-top"><span>Lượt bắt đầu</span><span class="metric-icon">↗</span></div><div class="metric-value">@Model.AttemptCount<small>lượt</small></div><p>Tất cả lượt thi của đề</p></article><article class="metric"><div class="metric-top"><span>Đã hoàn tất</span><span class="metric-icon">✓</span></div><div class="metric-value">@Model.CompletedAttemptCount<small>lượt</small></div><p>Đã nộp hoặc đã hết giờ</p></article><article class="metric gold"><div class="metric-top"><span>Tỷ lệ đúng trung bình</span><span class="metric-icon">◎</span></div><div class="metric-value">@Model.AverageCorrectPercentage.ToString("0.00")<small>%</small></div><p>Chỉ tính các lượt đã hoàn tất</p></article><article class="metric"><div class="metric-top"><span>Sinh viên tham gia</span><span class="metric-icon">♧</span></div><div class="metric-value">@Model.DistinctLearnerCount<small>người</small></div><p>Theo định danh người làm bài</p></article></section>
<div class="dashboard-grid"><section class="panel"><div class="panel-header"><div><h2>10 câu cần chú ý nhất</h2><p>Xếp theo số lần chọn sai; câu bỏ qua được thống kê riêng.</p></div></div>@if (Model.TopIncorrectQuestions.Count == 0) { <div class="empty-state"><div class="empty-symbol">↗</div><h3>Chưa có kết quả hoàn tất</h3><p>Biểu đồ sẽ xuất hiện khi sinh viên nộp bài hoặc khi hệ thống kết thúc một lượt hết giờ.</p></div> } else { <div class="panel-body"><div class="bar-list">@foreach (var item in Model.TopIncorrectQuestions) { <div class="bar-row"><span>Câu @item.OriginalNumber</span><div class="bar-track"><div class="bar-value" style="width:@((item.IncorrectCount * 100m / maximum).ToString("0.##", CultureInfo.InvariantCulture))%"></div></div><strong>@item.IncorrectCount sai</strong></div> }</div></div><div class="table-scroll"><table class="tf-table"><thead><tr><th>Câu hỏi</th><th>Số lần sai</th><th>Số lần bỏ qua</th></tr></thead><tbody>@foreach (var item in Model.TopIncorrectQuestions) { <tr><td><a asp-action="Details" asp-route-id="@Model.ExamId" asp-fragment="question-@item.OriginalNumber">Câu @item.OriginalNumber</a></td><td>@item.IncorrectCount</td><td>@item.SkippedCount</td></tr> }</tbody></table></div> }</section><aside class="panel format-card"><div class="panel-body"><span class="eyebrow">CÁCH ĐỌC KẾT QUẢ</span><h2 style="margin-top:10px">Mỗi con số là một cơ hội.</h2><ul class="info-list" style="margin-top:23px"><li><strong>Tỷ lệ đúng</strong>Số câu đúng / tổng số câu × 100. Không quy đổi sang thang điểm TOEIC 495 hoặc 990.</li><li><strong>Câu sai và bỏ qua</strong>Hai chỉ số được tách riêng để nhận diện lỗ hổng kiến thức và tiến độ làm bài.</li><li><strong>Dữ liệu đã hoàn tất</strong>Lượt đang làm không ảnh hưởng tỷ lệ đúng trung bình.</li></ul></div></aside></div>
