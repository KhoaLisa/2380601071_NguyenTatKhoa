@using NguyenTatKhoa_2380601071.Toeic
@using NguyenTatKhoa_2380601071.Web.Models.Exams
@model ExamPublishViewModel
@{
    Layout = "~/Views/Shared/_ToeicLayout.cshtml";
    ViewBag.Title = "Xuất bản đề thi";
    ViewBag.Section = "Exams";
}
<div class="page-heading"><div><span class="eyebrow">SẴN SÀNG CHO HÀNH TRÌNH MỚI</span><h1>Kiểm tra. Xác nhận. Xuất bản.</h1><p>Một bước cuối trước khi đề thi đến với sinh viên.</p></div><a asp-action="Details" asp-route-id="@Model.Exam.Id" class="button">← Xem trước đề</a></div>
<div class="publish-grid"><section class="panel"><div class="panel-header"><h2>Tóm tắt đề thi</h2><span class="status @(Model.Exam.Status == ExamStatus.Published ? "published" : "")">@(Model.Exam.Status == ExamStatus.Published ? "Đã xuất bản" : "Bản nháp")</span></div><div class="panel-body"><h2>@Model.Exam.Title</h2><dl class="summary-list" style="margin-top:15px"><div><dt>Mã đề</dt><dd>@Model.Exam.Code</dd></div><div><dt>Phiên bản</dt><dd>@Model.Exam.Version</dd></div><div><dt>Tổng câu hỏi</dt><dd>@Model.Exam.QuestionCount câu</dd></div><div><dt>Thời lượng</dt><dd>@Model.Exam.DurationMinutes phút</dd></div><div><dt>Nhóm bài đọc</dt><dd>@Model.Exam.Groups.Count nhóm</dd></div><div><dt>Khóa nội dung</dt><dd>@(Model.Exam.IsLocked ? "Đã có lượt thi" : "Chưa có lượt thi")</dd></div></dl></div></section><section class="panel"><div class="panel-body"><span class="eyebrow">KIỂM TRA MÁY CHỦ</span><h2 style="margin-top:10px">@(Model.Validation.CanPublish ? "Nội dung đã sẵn sàng." : "Còn một vài điều cần hoàn thiện.")</h2><p class="small muted">Hệ thống kiểm tra câu hỏi, lựa chọn, đáp án, quan hệ bài đọc và thời lượng trước khi xuất bản.</p>@if (Model.Validation.CanPublish && Model.Exam.Status == ExamStatus.Draft) { <div class="publish-check">✓ Cấu trúc đề đã vượt qua kiểm tra.</div><form asp-action="Publish" method="post" data-busy style="margin-top:20px"><input type="hidden" name="id" value="@Model.Exam.Id" /><p class="small muted" style="margin-bottom:18px">Khi xuất bản, sinh viên có thể bắt đầu bài thi. Sau khi có lượt thi, nội dung sẽ được khóa.</p><button class="button primary" type="submit">Xác nhận xuất bản →</button><span class="busy-indicator">Đang xuất bản…</span></form> } else if (Model.Exam.Status == ExamStatus.Published) { <div class="publish-check">✓ Đề này đã xuất bản.</div> } else { <a asp-action="Edit" asp-route-id="@Model.Exam.Id" class="button primary" style="margin-top:20px">Quay lại chỉnh sửa</a> }</div></section></div>
@if (Model.Validation.Errors.Count > 0) { <section class="panel"><div class="panel-header"><h2>@Model.Validation.Errors.Count vấn đề cần xử lý</h2></div>@await Html.PartialAsync("_ValidationErrors", Model.Validation.Errors)</section> }
